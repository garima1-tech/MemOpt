# MemOpt configuration. Copy this file to ".env" and fill in your password.
# .env is listed in .gitignore - NEVER commit it.
# Environment variables with the same names override this file.

# ---- PostgreSQL ---------------------------------------------------------
MEMOPT_DB_HOST=localhost
MEMOPT_DB_PORT=5432
MEMOPT_DB_NAME=memopt_demo
MEMOPT_DB_USER=postgres
MEMOPT_DB_PASSWORD=
MEMOPT_DB_CONNECT_TIMEOUT=5
# Any database other than memopt_demo is opened READ-ONLY unless you set 0 here.
# MEMOPT_DB_READONLY=1

# ---- Web server (localhost only by default) -------------------------------
MEMOPT_SERVER_HOST=127.0.0.1
MEMOPT_SERVER_PORT=8080

# ---- Metrics ------------------------------------------------------------
# fallback : labelled synthetic latency + estimated MLP (works everywhere)
# measured : require real per-unit latency/MLP; AOL is "unavailable" otherwise
MEMOPT_METRIC_SOURCE=fallback
# auto | fallback | linux-perf
MEMOPT_PROFILER=auto

# ---- Fallback model assumptions (illustrative, NOT from the paper) --------
MEMOPT_BASE_LATENCY_NS=100
MEMOPT_MLP_SEQUENTIAL=48
MEMOPT_MLP_RANDOM=9
MEMOPT_MLP_REPEATED=20
MEMOPT_SLOW_TIER_PENALTY=2.0
MEMOPT_SEED=42

# ---- Placement policy ---------------------------------------------------
MEMOPT_FAST_CAPACITY=6
MEMOPT_AOL_HIGH=7
MEMOPT_AOL_LOW=3
MEMOPT_COOLDOWN_EPOCHS=1
MEMOPT_CONFIRM_EPOCHS=1
MEMOPT_SWAP_MARGIN=0.25
MEMOPT_DRY_RUN=0

# ---- Benchmark ----------------------------------------------------------
MEMOPT_BENCH_EPOCHS=4
MEMOPT_BENCH_REPETITIONS=3
MEMOPT_WARMUP_RUNS=1
